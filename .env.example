# ==============================================================================
# ADRIAN AI — Configuración de entorno (plantilla)
# ==============================================================================
# 1. Copia este archivo como ".env" en D:\adrian-ai\
# 2. Pega tu Gemini API Key (Paid Tier obligatorio para datos de BIMCAT S.R.L.)
# 3. NUNCA subas ".env" a GitHub ni compartas la llave en chats.

GOOGLE_GENAI_API_KEY=pega_aqui_tu_api_key

# Ruteo de modelos
ADRIAN_FAST_MODEL=gemini-3.1-flash-lite
ADRIAN_STANDARD_MODEL=gemini-3.8-flash
ADRIAN_PRO_MODEL=gemini-3.1-pro-preview
ADRIAN_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# Base de datos principal (RECOMENDADO): PostgreSQL + pgvector en Docker local
# Levanta con: docker compose up -d
# Luego pobla con: npm run seed:db
# Si dejas DATABASE_URL vacío, ADRIAN AI usa memoria/memoria.json en local.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://adrian:adrian_local_dev@localhost:5432/adrian_ai
POSTGRES_USER=adrian
POSTGRES_PASSWORD=adrian_local_dev
POSTGRES_DB=adrian_ai
POSTGRES_PORT=5432

# Opción alternativa en la nube (solo si decides usar Supabase en lugar de Docker)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSETS_BUCKET=adrian-assets

# Carpetas adicionales que ADRIAN AI puede LEER (separadas por ";").
# contexto/ y proyectos/ siempre están incluidos en solo lectura.
ADRIAN_ALLOWED_READ_DIRS=D:\Creative_AI_Business\Creative_AI_Business

# ------------------------------------------------------------------------------
# Fase 4 — GitHub (Módulo B) y Automatizaciones n8n (Docker local)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
ADRIAN_AUTOMATION_TOKEN=

# ------------------------------------------------------------------------------
# Fase 5 — Telemetría de LLM (precios por 1M de tokens, USD)
# Ajustar según la tarifa vigente de Gemini. Valores por defecto referenciales.
# ------------------------------------------------------------------------------
GEMINI_PRICE_FLASH_LITE_INPUT_USD_PER_M=0.075
GEMINI_PRICE_FLASH_LITE_OUTPUT_USD_PER_M=0.30
GEMINI_PRICE_FLASH_INPUT_USD_PER_M=0.15
GEMINI_PRICE_FLASH_OUTPUT_USD_PER_M=0.60
GEMINI_PRICE_PRO_INPUT_USD_PER_M=1.25
GEMINI_PRICE_PRO_OUTPUT_USD_PER_M=5.00
