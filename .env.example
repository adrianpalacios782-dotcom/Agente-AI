# ==============================================================================
# ADRIAN AI — Configuración de entorno (plantilla)
# ==============================================================================
# 1. Copia este archivo como ".env" en D:\adrian-ai\
# 2. Pega tu Gemini API Key (Paid Tier recomendado para datos de BIMCAT S.R.L.)
# 3. NUNCA subas ".env" a GitHub ni compartas la llave en chats.

GOOGLE_GENAI_API_KEY=pega_aqui_tu_api_key

# Ruteo de modelos (puedes cambiarlos según https://ai.google.dev/gemini-api/docs/models)
ADRIAN_FAST_MODEL=gemini-flash-lite-latest
ADRIAN_STANDARD_MODEL=gemini-flash-latest
ADRIAN_PRO_MODEL=gemini-pro-latest

# Carpetas que ADRIAN AI puede LEER (separadas por ";"). Solo lectura.
ADRIAN_ALLOWED_READ_DIRS=D:\adrian-ai\knowledge;D:\Creative_AI_Business\Creative_AI_Business

# (Opcional) Raíz del proyecto si ejecutas desde otra carpeta
# ADRIAN_HOME=D:\adrian-ai
