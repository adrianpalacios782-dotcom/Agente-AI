# ==============================================================================
# ADRIAN AI — Configuración de entorno (plantilla)
# ==============================================================================
# 1. Copia este archivo como ".env" en D:\adrian-ai\
# 2. Pega tu Gemini API Key (Paid Tier obligatorio para datos de BIMCAT S.R.L.)
# 3. NUNCA subas ".env" a GitHub ni compartas la llave en chats.

GOOGLE_GENAI_API_KEY=pega_aqui_tu_api_key

# Ruteo de modelos (ajusta según https://ai.google.dev/gemini-api/docs/models)
ADRIAN_FAST_MODEL=gemini-flash-lite-latest
ADRIAN_STANDARD_MODEL=gemini-flash-latest
ADRIAN_PRO_MODEL=gemini-pro-latest
ADRIAN_EMBEDDING_MODEL=gemini-embedding-001

# Fase 2 — Supabase (PostgreSQL + pgvector + Storage privado)
# Si se dejan vacíos, ADRIAN AI usa automáticamente memoria/memoria.json en local.
# Consulta supabase/README.md para aplicar la migración 001_initial_schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSETS_BUCKET=adrian-assets

# Carpetas adicionales que ADRIAN AI puede LEER (separadas por ";").
# contexto/ y proyectos/ siempre están incluidos en solo lectura.
ADRIAN_ALLOWED_READ_DIRS=D:\Creative_AI_Business\Creative_AI_Business

# (Opcional) Raíz del proyecto si ejecutas desde otra carpeta
# ADRIAN_HOME=D:\adrian-ai
